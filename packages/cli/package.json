
{
  "name": "folder-structure-pro",
  "version": "0.1.0",
  "private": true,
  "description": "CLI to generate, copy, export, and recreate project folder structures.",
  "author": "Shrey Purohit",
  "license": "MIT",
  "keywords": [
    "folder-structure",
    "folder-structure-cli",
    "directory-structure",
    "directory-structure-cli",
    "directory-tree",
    "folder-tree",
    "project-structure",
    "project-tree",
    "file-tree",
    "directory-visualizer",
    "cli",
    "command-line",
    "filesystem",
    "file-system",
    "developer-tools",
    "scaffolding"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShreyPurohit/folder-structure-pro-vscode.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ShreyPurohit/folder-structure-pro-vscode#readme",
  "bugs": {
    "url": "https://github.com/ShreyPurohit/folder-structure-pro-vscode/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "bin": {
    "folder-structure-pro": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm --filter @folder-structure-pro/core build && pnpm run build:bundle",
    "build:bundle": "node esbuild.mjs",
    "check-types": "pnpm --filter @folder-structure-pro/core build && pnpm run check-types:built",
    "check-types:built": "tsc --noEmit -p tsconfig.json",
    "prepare-release": "node scripts/prepare-release.mjs",
    "validate-package": "pnpm run prepare-release && vitest run --config vitest.config.ts test/packaging.test.ts",
    "test": "pnpm run prepare-release && pnpm run test:built",
    "test:built": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "clipboardy": "5.3.2"
  },
  "devDependencies": {
    "@clack/prompts": "1.9.0",
    "@folder-structure-pro/core": "workspace:*"
  }
}
