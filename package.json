{
  "name": "copy-folder-structure",
  "displayName": "Folder Structure Pro",
  "description": "Easily copy & create folder structures, file names and jump-ready line paths with a single click.",
  "publisher": "iamshreydxv",
  "version": "0.2.2",
  "engines": {
    "vscode": "^1.54.0"
  },
  "icon": "assets/icon.webp",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": true
  },
  "galleryBanner": {
    "color": "#0b1620",
    "theme": "dark"
  },
  "contributes": {
    "keybindings": [
      {
        "command": "extension.copyLinePath",
        "key": "ctrl+shift+t",
        "mac": "cmd+k cmd+t",
        "when": "editorTextFocus && resourceScheme == file"
      }
    ],
    "commands": [
      {
        "command": "extension.copyFolderStructure",
        "title": "Copy Folder Structure",
        "category": "Explorer"
      },
      {
        "command": "extension.createProjectFromStructure",
        "title": "Create Folder Structure",
        "category": "Explorer"
      },
      {
        "command": "extension.copyFileName",
        "title": "Copy File Name",
        "category": "Explorer"
      },
      {
        "command": "extension.copyLinePath",
        "title": "Copy Line Path",
        "category": "Editor"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "extension.copyFolderStructure",
          "when": "resource",
          "group": "5_folder-structure-pro"
        },
        {
          "command": "extension.createProjectFromStructure",
          "when": "resource",
          "group": "5_folder-structure-pro"
        },
        {
          "command": "extension.copyFileName",
          "when": "resourceExtname",
          "group": "5_folder-structure-pro"
        }
      ],
      "editor/context": [
        {
          "command": "extension.copyLinePath",
          "when": "editorTextFocus && resourceScheme == file",
          "group": "5_folder-structure-pro"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Folder Structure Pro",
      "properties": {
        "folderStructure.outputFormat": {
          "type": "string",
          "enum": [
            "JSON Format",
            "Plain Text Format"
          ],
          "default": "Plain Text Format",
          "description": "Format of the folder structure output (JSON or plain text)"
        },
        "folderStructure.ignorePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".*"
          ],
          "description": "Patterns to ignore when copying folder structure"
        },
        "folderStructure.respectGitignore": {
          "type": "boolean",
          "default": true,
          "description": "Whether to respect .gitignore patterns when copying folder structure"
        },
        "folderStructure.copyLine.includeColumn": {
          "type": "boolean",
          "default": false,
          "description": "Include column number when copying path (path:line:column)."
        },
        "folderStructure.copyLine.useAbsolutePath": {
          "type": "boolean",
          "default": false,
          "description": "Copy absolute file path instead of workspace-relative path."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "check-types:test": "tsc --noEmit -p test/tsconfig.json",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.19.42",
    "@types/vscode": "^1.54.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "funding": "https://github.com/sponsors/ShreyPurohit",
  "badges": [
    {
      "url": "https://img.shields.io/badge/license-MIT-blue.svg",
      "href": "https://opensource.org/licenses/MIT",
      "description": "MIT License"
    }
  ],
  "licenses": [
    {
      "type": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  ],
  "keywords": [
    "folder structure",
    "copy folder structure",
    "create folder structure",
    "copy file name",
    "copy line path",
    "copy file path",
    "copy file",
    "line path",
    "git ingest",
    "project scaffolding",
    "json",
    "plain text",
    "tree",
    "gitignore",
    "clipboard",
    "explorer context menu",
    "productivity",
    "developer tools",
    "workspace fs",
    "remote"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ShreyPurohit/folder-structure-pro-vscode.git"
  },
  "qna": "https://marketplace.visualstudio.com/items?itemName=iamshreydxv.copy-folder-structure&ssr=false#qna",
  "bugs": {
    "url": "https://github.com/ShreyPurohit/folder-structure-pro-vscode/issues"
  },
  "homepage": "https://github.com/ShreyPurohit/folder-structure-pro-vscode#readme"
}
