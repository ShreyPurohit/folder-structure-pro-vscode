{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "lib": ["ES2022"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["vitest/globals", "node"],
        "paths": {
            "vscode": ["./__mocks__/vscode.ts"]
        }
    },
    "include": ["./**/*.ts", "../src/**/*.ts", "../vitest.config.ts"]
}
